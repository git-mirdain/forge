{
  "terminal": {
    "env": {
      "PATH": "target/debug:$PATH",
      "MANPATH": "$PWD/target/share/man:$MANPATH"
    }
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "forge-lsp"]
    },
    "Markdown": {
      "language_servers": ["forge-lsp"]
    },
    "TOML": {
      "language_servers": ["forge-lsp"]
    }
  },
  "lsp": {
    "forge-lsp": {
      "binary": {
        "path": "target/debug/forge-lsp"
      }
    }
  },
  "context_servers": {
    "forge-mcp": {
      "source": "custom",
      "command": {
        "path": "target/debug/forge-mcp",
        "args": []
      }
    }
  }
}
